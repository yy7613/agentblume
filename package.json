{
  "name": "agentblume",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "agentblume — ノーコード・エージェントIDE (v1 increment: ETL Tool Engine)",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "demo": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx src/demo.ts",
    "serve": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx src/server.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "dependency-cruiser": "^18.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@mastra/core": "^1.50.1",
    "@mastra/evals": "^1.5.1",
    "@xyflow/react": "^12.11.1",
    "fastify": "^5.9.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
