# Optional local runtime profile
AGENTCONTEXT_PROFILE=local

# Optional local LLM analysis-setting assistant. It is displayed only when
# LM_STUDIO_MODEL is set and this switch is not false. It never executes code
# or changes a Tool until the user applies the validated proposal.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LM_STUDIO_MODEL=
ANALYSIS_ASSISTANT_ENABLED=true

# Database connection definitions are resolved by the backend only.
# Keep passwords in a separate environment variable named by passwordEnv.
# The database user must be read-only. Only tables/views in allowedTables can be used by database-source.
AGENTCONTEXT_DB_CONNECTIONS={"reporting":{"driver":"postgresql","host":"127.0.0.1","port":5432,"database":"reporting","username":"agentcontext_reader","passwordEnv":"REPORTING_DB_PASSWORD","ssl":false,"allowedTables":["public.sales_daily"]}}

# Set this in your local shell or secret store; do not commit its real value.
# REPORTING_DB_PASSWORD=

# Optional web-search providers. A provider whose required values are absent is
# not exposed in the Tool Builder. Search is called only by the explicit
# "Fetch results" action; see docs/adr/0030-optional-web-search-providers.md.
# TAVILY_API_KEY=
# TINYFISH_API_KEY=
# GOOGLE_CUSTOM_SEARCH_API_KEY=
# GOOGLE_CUSTOM_SEARCH_ENGINE_ID=
