# agentblume backend environment variables
#
# ここに列挙したものが「実際にコードから読まれている env」の全量である。
# 対応する検証定義は src/config/environment.ts にあり、起動時（npm run serve / npm start）に
# **まとめて検証**する。1つでも不正なら、何がどう不正かを並べて起動を中止する。
#
# 読み込まれ方:
#   このファイルを `.env` にコピーして値を書く。`npm run serve` / `npm start` / `npm run demo` /
#   `npm run llmops:gate` は Node の `--env-file-if-exists=.env` で読む（.env が無くてもエラーにならない）。
#   **既にシェルに設定されている環境変数は .env より優先される**（scripts/start-dev.ps1 の
#   -Profile / -ApiPort / -SampleData が .env に負けないのはこのため）。
#   `npm run dev:ui`（vite）は AGENTCONTEXT_API_URL を .env からは読まない。start-dev.ps1 が渡す。
#
# 表記: 値なしのコメント行は「未設定でよい」項目。既定値はコメントに書く。

# ---------------------------------------------------------------------------
# 実行プロファイルと保存先
# ---------------------------------------------------------------------------

# local | test。既定は local。
AGENTCONTEXT_PROFILE=local

# SQLiteの保存先。**未設定なら ~/.agentblume/agentblume.db（永続ファイル）** を使う。
# ':memory:' を明示した場合だけ、プロセス終了で全データが消える。
# 親ディレクトリは自動作成する。起動時に実際の保存先をログへ出す。
# AGENTCONTEXT_DB_PATH=

# APIのlistenポート。1〜65535の整数。既定 3030。
# AGENTCONTEXT_PORT=3030

# APIのlistenホスト。既定 127.0.0.1（ローカルIDEなのでループバックに閉じる）。
# 他のマシンから触らせる場合だけ 0.0.0.0 等にする。
# **ループバック以外へバインドする場合は AGENTCONTEXT_AUTH_TOKENS が必須**（未設定なら起動しない）。
# 単一ユーザーモードは資格情報を一切求めないので、公開した瞬間に誰でも全データを触れてしまう。
# AGENTCONTEXT_HOST=127.0.0.1

# 'true' なら起動時に手動確認用のサンプルデータを投入する（既存IDは再作成しない）。true | false。
# AGENTCONTEXT_SAMPLE_DATA=false

# 保存・参照するテナントスコープ（既定 local / default）。
# AGENTCONTEXT_TENANT_ID=local
# AGENTCONTEXT_WORKSPACE_ID=default

# Run記録と /health /ready へ載せるソース版（Gitのcommit hash等）。未設定なら記録・応答しない。
# デプロイ時に埋めると「今動いているのがどのビルドか」が /health で分かる。
# AGENTCONTEXT_SOURCE_REVISION=

# ビルド済みUI（index.html を含むディレクトリ）の明示指定。
# 未設定の場合、npm start（dist/server/server.js）は隣の dist/ui を探し、見つかればAPIと同じポートで配信する。
# npm run serve（開発）は探索しない（古い dist/ui を掴むとVite開発サーバーとの区別がつかなくなるため）。
# 明示したのに index.html が無い場合はUI配信を行わない（別のUIを黙って配らないため）。
# AGENTCONTEXT_UI_ROOT=

# SIGINT/SIGTERM を受けたあと、**実行中**の実験・Factory Runの完了を待つ上限（0以上の整数・ミリ秒・既定 10000）。
# 猶予を過ぎたジョブは中断する。未実行のキューは待たずに捨てる（キューはメモリ内のため）。
# 中断・破棄されたジョブは次の起動時に回収される（Factory Runは failed→再実行、実験は interrupted→再開、
# queued は自動で再投入）。ただし途中経過は失われるので、待てるなら待つほうがよい。
# 0 にすると待たずに即中断する。2回目の Ctrl+C でも猶予を打ち切って即終了できる。
# AGENTCONTEXT_SHUTDOWN_GRACE_MS=10000

# 保持期限（retention）の自動実行間隔（0以上の整数・ミリ秒・既定 86400000＝24時間）。
# 保持期限は日単位の設定なので、これより短くしても削除対象は増えない。
# 初回は起動直後ではなく1インターバル後に走る（起動のたびに重い削除が走らないようにするため）。
# 0 にすると自動実行しない（掃除は POST /operations/retention/apply の手動実行だけになる）。
# 対象は「Runを1件以上持つ全スコープ」＋起動スコープ。削除件数は毎回ログに出る。
# AGENTCONTEXT_RETENTION_INTERVAL_MS=86400000

# サーバー（Fastify/pino）のログレベル。fatal | error | warn | info | debug | trace | silent。
# **既定はプロファイル依存**: local=info / test=silent。
# test を silent にしているのはE2Eやテスト用起動でリクエストごとに2行流れるのを止めるため。
# 調べたいときはここで明示すれば既定より優先される（silent でも封じてはいない）。
# ログには機微情報のマスク（redact）がかかる: Authorization / Cookie / x-api-key ヘッダ、
# ボディとログcontextの apiKey / password / token / secret / accessToken 等（src/api/logging.ts）。
# リクエストIDは Fastify が自動で `reqId` として全行に載せる。
# AGENTCONTEXT_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# 認証（テナント境界を決める主体）
# ---------------------------------------------------------------------------
#
# サーバーは**認証済みPrincipalから**テナントスコープを決める。リクエストのボディやクエリに
# 書かれた tenantId / workspaceId は受理はするが読まない（書き換えても他テナントへは届かない）。
#
# 未設定なら「単一ユーザーモード」: 資格情報を求めず、常に AGENTCONTEXT_TENANT_ID /
# _WORKSPACE_ID の Principal として扱う（＝これまでどおりのローカル利用）。
# ただし **AGENTCONTEXT_HOST がループバック以外なら起動を拒否する**。

# single-user | token。既定は「AGENTCONTEXT_AUTH_TOKENS があれば token、無ければ single-user」。
# 通常は書かなくてよい（書き忘れて無認証になる事故を防ぐため、トークンの有無から決まる）。
# AGENTCONTEXT_AUTH_MODE=

# Bearerトークンの一覧（JSON配列）。**人ごとに1本**にすると、監査で「誰が」を残せて
# 1人分だけ失効させられる。token は32文字以上・空白なし。
# tenantId / workspaceId を省略すると AGENTCONTEXT_TENANT_ID / _WORKSPACE_ID を引き継ぐ。
# 明示すればトークンごとにテナントを分けられる（テナント境界が実際に効く）。
# roles は次のWave（RBAC）用に運ぶだけで、現時点の判定には使わない。
# 生成例: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# 値はログにもエラーメッセージにも出ない。**このファイルの実値はコミットしないこと**。
# AGENTCONTEXT_AUTH_TOKENS=[{"subject":"alice","token":"<32文字以上のランダム文字列>","displayName":"Alice"},{"subject":"bob","token":"<別のランダム文字列>","tenantId":"globex","workspaceId":"main"}]

# ---------------------------------------------------------------------------
# 秘密値の暗号鍵
# ---------------------------------------------------------------------------

# UIから保存したAPIキーを封緘するAES-256-GCM鍵ファイル。
# 既定は ~/.agentblume/secret.key（初回利用時に自動生成）。
# **DBファイルとは別の場所に置くこと**（DBだけが流出しても平文キーを復元できないようにするため）。
# AGENTCONTEXT_SECRET_KEY_PATH=

# ---------------------------------------------------------------------------
# バックアップ
# ---------------------------------------------------------------------------

# バックアップ（`npm run backup` / ステータス画面の「バックアップを作成」）の出力先ディレクトリ。
# 既定はDBファイルの隣（例: ~/.agentblume/agentblume.db.backups）。
# 1回のバックアップにつき backup-YYYYMMDD-HHMMSSmmm/ が1つ増える（DB + セッションアーティファクト + manifest.json）。
# **暗号鍵は既定で含まれない**。別ドライブ・別マシンへの複製は利用者の運用（docs/17-operations-runbook.md）。
# AGENTCONTEXT_BACKUP_DIR=

# ---------------------------------------------------------------------------
# モデル（LM Studio / OpenAI互換エンドポイント）
# ---------------------------------------------------------------------------

# main スロットの既定。UIのモデル設定を保存していないときだけ使われる。http:// か https:// で始めること。
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# ロード済みモデルの識別子。未設定だとAgent実行は拒否される（暗黙選択はしない）。
# LM_STUDIO_MODEL=
# Bearer tokenが必要な場合のみ設定。
# LM_STUDIO_API_KEY=
# 推論の総時間timeout（正の整数・ミリ秒・既定 600000 = 10分）。
# LM_STUDIO_TIMEOUT_MS=600000
# 出力が1バイトも来ない状態の上限（正の整数・ミリ秒・既定 60000）。長考中は出力継続で更新される。
# LM_STUDIO_IDLE_TIMEOUT_MS=60000
# 未設定なら max_tokens を送らずモデル既定に委ねる（正の整数）。
# LM_STUDIO_MAX_TOKENS=

# judge スロット（LLM-as-a-judge 評価用）の既定。main と同じ意味。
# JUDGE_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# JUDGE_LM_STUDIO_MODEL=
# JUDGE_LM_STUDIO_API_KEY=

# Tool Builderの分析設定アシスタント。true | false（既定 true）。
# LM_STUDIO_MODEL か保存済みmainスロットがあるときだけ表示される。
# コードの実行やToolの変更は行わず、検証済みの提案を利用者が適用したときにだけ反映される。
ANALYSIS_ASSISTANT_ENABLED=true

# Mastra SDK 用。src/mastra-runtime-env.ts が未設定時に既定値を入れる（外部送信の抑止）。
# 通常は書き換えない。
# MASTRA_TELEMETRY_DISABLED=true
# MASTRA_OFFLINE=1

# ---------------------------------------------------------------------------
# データソース（DB接続）
# ---------------------------------------------------------------------------

# DB接続定義はbackendだけが解決する。パスワードは passwordEnv で指定した別のenvに置く。
# DBユーザーは読み取り専用にし、allowedTables に列挙したtable/viewだけを database-source から使える。
# 形式: { "<接続ID>": { driver:"postgresql", host, database, username, passwordEnv,
#                       port?, ssl?, allowedTables?[] } } のJSONオブジェクト。
# **JSONとして壊れている場合は起動しない**（以前は黙って「接続なし」になり、原因が分からなかった）。
AGENTCONTEXT_DB_CONNECTIONS={"reporting":{"driver":"postgresql","host":"127.0.0.1","port":5432,"database":"reporting","username":"agentcontext_reader","passwordEnv":"REPORTING_DB_PASSWORD","ssl":false,"allowedTables":["public.sales_daily"]}}

# passwordEnv が指す変数。ローカルのシェルや秘密ストアで設定し、実値はコミットしない。
# 未設定でも起動はする（その接続だけが「利用不可」として表示される）。
# REPORTING_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Web検索provider（任意）
# ---------------------------------------------------------------------------

# 必要な値が無いproviderはTool Builderに表示されない。検索は作成者の「検索結果を取得」操作でだけ実行する。
# 詳細は docs/adr/0030-optional-web-search-providers.md。
# TAVILY_API_KEY=
# TINYFISH_API_KEY=
# Google Custom Search は API キーと Engine ID の**両方**が揃ったときだけ有効になる。
# GOOGLE_CUSTOM_SEARCH_API_KEY=
# GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# ---------------------------------------------------------------------------
# 観測・運用（任意）
# ---------------------------------------------------------------------------

# 'true' で OpenTelemetry を配線する（既定は no-op で、SDKの読み込みすら行わない）。true | false。
#
# 有効にすると起動時に TracerProvider（@opentelemetry/sdk-trace-node）を登録し、
# span を OTLP/HTTP（@opentelemetry/exporter-trace-otlp-http）で送る。
# 送られるのは実装済みの4種類: agent.run / model.complete / tool.execute / evaluation.case。
# service.name は 'agentblume'、AGENTCONTEXT_SOURCE_REVISION があれば service.version に載せる。
# shutdown（SIGINT/SIGTERM）時に未送信ぶんをフラッシュする。
#
# 受け口を1つ用意する例（ローカルにcollectorを立てる）:
#   docker run --rm -p 4318:4318 otel/opentelemetry-collector:latest
# そのうえで .env に次の2行:
#   AGENTCONTEXT_OTEL_ENABLED=true
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# AGENTCONTEXT_OTEL_ENABLED=false

# exporter の送信先。**OTel標準のenv**で、値を解釈するのはSDK側（このアプリではない）。
# 未設定なら OTLP/HTTP の既定 http://localhost:4318 が使われる。
# ENDPOINT はベース（末尾に /v1/traces が足される）、TRACES_ENDPOINT はtrace専用の完全なURL。
# どちらも http:// か https:// で始まること（打ち間違えると送信に失敗するだけで静かにspanが消える）。
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
#
# 認証ヘッダ・サンプリング等のその他 OTEL_* も SDK がそのまま読む（このアプリは検証しない）。
# 一覧: https://opentelemetry.io/docs/specs/otel/configuration/sdk-environment-variables/
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer xxxxx

# 推定コスト計算に使う価格表（JSON配列）。未設定なら local では価格を推定しない。
# 各要素: { provider, model, inputPerMillionTokens, outputPerMillionTokens, effectiveAt }。
# AGENTCONTEXT_MODEL_PRICING_JSON=[{"provider":"lm-studio","model":"local","inputPerMillionTokens":0,"outputPerMillionTokens":0,"effectiveAt":"2026-01-01T00:00:00.000Z"}]

# ---------------------------------------------------------------------------
# UI / E2E（開発用）
# ---------------------------------------------------------------------------

# UI（vite dev server）が叩くAPIのURL。start-dev.ps1 と playwright が自動で渡す。
# vite はこの値を .env からは読まないので、手で `npm run dev:ui` する場合はシェルで設定する。
# AGENTCONTEXT_API_URL=http://127.0.0.1:3030

# 'true' でスクリーンショット取得を実モデル実行つきで行う（npm run docs:screenshots:live）。true | false。
# AGENTCONTEXT_MANUAL_LIVE=false
